{
  "name": "pi-context-kit",
  "version": "0.4.4",
  "description": "Keep long Pi coding agent sessions sharp. Clears old file reads and tool outputs from the context, writes the compaction summary in the background, and lets the agent recall the original text.",
  "keywords": [
    "coding-agent",
    "compaction",
    "context",
    "context-management",
    "context-window",
    "handoff",
    "llm",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "token-optimization"
  ],
  "homepage": "https://github.com/HugoLopes45/pi-extensions/tree/main/packages/pi-context-kit#readme",
  "bugs": {
    "url": "https://github.com/HugoLopes45/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Hugo Lopes (https://github.com/HugoLopes45)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoLopes45/pi-extensions.git",
    "directory": "packages/pi-context-kit"
  },
  "files": [
    "extensions",
    "src",
    "context-kit.schema.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest --run",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "pi-hl-utils": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "bundledDependencies": [
    "pi-hl-utils"
  ],
  "engines": {
    "node": ">=22.19.0",
    "pi": ">=1.0.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
